#!/bin/bash

usage() {
	cat <<EOF
USAGE: ${0##*/} [-D] [-C] [-c xshift,yshift] [-d ysep] [-w width] [-s scale] [-t y,m,d] [-S picture|text] <background PDF>

EXAMPLES:
1. ${0##*/} -C -t'2024,6,7' -S'mysig.pdf'  pg_0001.pdf
   ${0##*/} -C -t'2024,6,7' -S'\sig 王晓林' pg_0002.pdf
  
2. ${0##*/} -C -S'机试' -c'60,2' -s .9 pg_0001-signed.pdf

3. ${0##*/} -w10cm -c'0,500' -S'../../../analysis-improve.pdf' os-analysis.pdf
   ${0##*/} -C -S'机试' -c'100,0' -d'110' -t'2024,12,16' os-analysis-signed.pdf

background - paper to sign
				-D - Enable debugging outputs and grid
				-C - Invoke getCoordinate
        -S - signature picture or text
				   	 Default='{.,..}/wangxiaolin.pdf' if found

        -c - 'xshift,yshift' 
				   	 Default '28,-18' in pt if signed with picture
						 Default '28,-25' in pt if signed with \sig font text

				-d - ysep, shift of the "date field". Default 180pt

        -t - timestamp, e.g. '2020,5,8'
        -w - width of signature picture. Default 1cm
        -s - scale of signature text. Default 1
EOF
	exit "${1:-0}"
}

cleanup() {
	[[ "$DEBUG" ]] || { rm -f "$AUX" "$LOG" "$TEX"; }
}

#######color code########
SUCCESS=$(tput setaf 2) # Green
ERROR=$(tput setaf 1)   # Red
DEBUG=$(tput setaf 3)   # Yellow
INFO=$(tput setaf 6)    # Cyan
colorEcho() {
		echo -e "$(tput bold) $1 $2 $(tput sgr0)"
}

# === Logging ===
LOG_FILE="/tmp/pdfsign.log"
true > "$LOG_FILE"
log_message() {
		local level=$1
		local message=$2
		echo -n "$(date '+%Y-%m-%d %H:%M:%S')"
		colorEcho "${!level}" "[$level] $message" | tee -a "$LOG_FILE"
}

# === Getting Coordinate ===
getCoordinate() {
		log_message "DEBUG" "Running getCoordinate $1 ..."
		read -ra XY < <(pdftotext -tsv "$1" - | rg -v "###.*###" | sk -e10 | choose 6 7)

		((${#XY[@]} == 2)) || {
				log_message "ERROR" "Wrong coordinate! XY: ${XY[*]}"
				return 1
		}

	X=${XY[0]}pt;	Y=${XY[1]}pt

	log_message "DEBUG" "[getCoordinate] XY: ${XY[*]}; X: $X; Y: $Y"
	return
}

# === Signing the background PDF page ===
signit() {
		log_message "DEBUG" "Signing $BG_PDF..."
		local MSG

		cat <<EOF >"$TEX"
\documentclass[tikz]{standalone}
\usetikzlibrary{backgrounds,positioning}
\usepackage[scheme=plain]{ctex}
\newCJKfontfamily\sig{signature}
\newfontfamily\purisa{Purisa}

\begin{document}
\begin{tikzpicture}[inner sep=0,anchor=north west,yscale=-1]
\node (bg) at (0,0) {\includegraphics[width=\paperwidth]{$1}};
\begin{scope}
EOF
	[[ $DEBUG ]] && {
			log_message "DEBUG" "[signit] Generating debug grid..."

		cat <<EOF >>"$TEX"
%%% Drawing grid
\draw[help lines,red,step=25pt] (0,0) grid (600pt,850pt);
\draw[thin] (0,0) rectangle (595pt,842pt); % a4: 595x842
\foreach \x in {0,50,100,...,600} { \node at (\x pt,0) {\x}; }%
\foreach \y in {0,50,100,...,850} { \node at (0,\y pt) {\y}; }%
EOF
	}

	if [[ -f "$SIG" ]]; then # sign with a PDF picture. $XY is from getCoordinate()
		cat <<EOF >>"$TEX"
\node (sig) at (${X:-96pt},${Y:-809.77pt}) [%
xshift=${XSHIFT:-28}pt, yshift=${YSHIFT:--18}pt] {%
\includegraphics[width=${WIDTH:-1cm}]{$SIG}};
EOF
		log_message "DEBUG" "Signing with $SIG, width=${WIDTH:-1cm}"
	else # sign with font
		cat <<EOF >>"$TEX"
\node (sig) at (${X:-96pt},${Y:-809.77pt}) [%
xshift=${XSHIFT:-28}pt, yshift=${YSHIFT:--25}pt,%
scale=${SIGSCALE:-1}] {$SIG};
EOF
		log_message "DEBUG" "[signit] Signing with text font, yshift=${YSHIFT:--25}pt"
	fi
	
	MSG=$(cat <<EOF
[signit] (X,Y) = (${X:-96pt},${Y:-809.77pt})
[xshift=${XSHIFT:-28}pt, yshift=${YSHIFT:--18}pt, scale=${SIGSCALE:-1}]
EOF
		 )
	log_message "DEBUG" "$MSG"

	[[ "$Year" ]] && {
		cat <<EOF >>"$TEX"
\node [right=${YSEP:-183}pt of sig, yshift=-3pt, font=\purisa] {%
$Year\hspace{1.5em}%
\makebox[1em][c]{$Month}\quad%
\makebox[1em][c]{$Day}};%
EOF
		log_message "DEBUG" "[signit] $Year,$Month,$Day at offset: ${YSEP:-183}pt"
	}
	cat <<EOF >>"$TEX"
\end{scope}
\end{tikzpicture}
\end{document}
EOF
}

trap cleanup EXIT

# defaults
[[ -e wangxiaolin.pdf ]] && SIG='wangxiaolin.pdf'
[[ -e ../wangxiaolin.pdf ]] && SIG='../wangxiaolin.pdf'

unset X Y XY XSHIFT YSHIFT YSEP MSEP DSEP DEBUG SCALE WIDTH

while getopts :DCc:d:s:w:t:S: OPT; do
	case $OPT in
	D) DEBUG='Y' ;;
	C) GETCOORDINATE='Y' ;;
	c) XSHIFT=${OPTARG%,*}; YSHIFT=${OPTARG#*,} ;;
	d) YSEP="$OPTARG" ;;
	s) SIGSCALE="$OPTARG" ;;
	w) WIDTH="$OPTARG" ;;
	t) DATE="$OPTARG"
		 IFS=',' read -ra date <<< "$DATE"
		 Year=${date[0]}; Month=${date[1]}; Day=${date[2]}
		 ;;
	S) SIG="$OPTARG" ;;
	?) usage 1 ;;
	esac
done
shift $((OPTIND - 1))
OPTIND=1

BG_PDF="$*"

[[ $(file --brief --mime-type "$BG_PDF") == "application/pdf" ]] || {
	log_message "$ERROR" "Background $BG_PDF is not a valid PDF file."
	exit 1
}

TEX="${BG_PDF%.pdf}-signed.tex"
true > $TEX
PDF="${TEX%.tex}.pdf"
LOG="${TEX%.tex}.log"
AUX="${TEX%.tex}.aux"

[[ $GETCOORDINATE ]] && getCoordinate "$BG_PDF"
# otherwise sign with default coordinate

signit "$BG_PDF"

log_message "INFO" "lualatex $TEX..."
lualatex "$TEX" 1>/dev/null

[[ -f "$PDF" ]] || {
		log_message "ERROR" "Failed generating PDF file. Please check <$LOG> file for details."
		exit 1
}

log_message "SUCCESS" 'DONE!'
ls -l "$PDF"
xdg-open "$PDF" &>/dev/null
