#!/bin/bash

usage() {
    cat <<EOF
Batch generating courseworks in current directory.

NOTE: Make sure you have plenty of .org/.md files in ${TEMPLATE_DIR}!

Usage: ${0##*/} [-hv] [-f format] [-C csvdir] [-D template_dir] [-P name_pattern] <semester> <course>

course - course name ($TEMPLATE_DIR/{os,linux,net})
semester - School term (e.g. 242501)

-f format, org or md
-C csvdir (default $CSVDIR)
-D template_dir (default $TEMPLATE_DIR)
-P filename pattern (default "^20", e.g. 20241152001.{org,md})
-h help
-v verbose (debug) mode
EOF

exit "${1:-0}"
}

trap 'rm -rf $OUTPUT_DIR"' EXIT

# defaults
CSVDIR="/home/wx672/Documents/rsync/swfu/yearly/moodle-import"
[[ -d "$CSVDIR" ]] || {
	echo "Error: CSVDIR ($CSVDIR) is not a valid directory"; exit 1;
}
TEMPLATE_DIR="/home/wx672/Documents/rsync/swfu/coursework-template"
[[ -d "$TEMPLATE_DIR" ]] || {
	echo "Error: TEMPLATE_DIR ($TEMPLATE_DIR) is not a valid directory"; exit 1;
}
PATN="^20"
FMT="md"

unset SEMESTER COURSE DEBUG

while getopts :hvf:C:D:P: OPT; do
    case $OPT in
        h) usage 0 ;;
		v) DEBUG=1 ;;
		f) FMT="$OPTARG" ;;
		C) CSVDIR="$OPTARG" ;;
		D) TEMPLATE_DIR="$OPTARG" ;;
        P) PATN="$OPTARG" ;;
        ?) usage 2
    esac
done
shift $(( OPTIND - 1 ))
OPTIND=1

SEMESTER="$1"
COURSE="$2"

[[ ${#SEMESTER} = 6 ]] || {
	echo "SEMESTER=$SEMESTER"
	echo "SEMESTER should be like e.g. 242501."
	usage 1
}

[[ "$COURSE" ]] || {
	echo "COURSE cannot be empty. It should be one of linux, net, os."
	usage 1
}

COURSE_DIR="$TEMPLATE_DIR/$COURSE"
[[ -d "$COURSE_DIR" ]] || {
	echo "Error: COURSE_DIR ($COURSE_DIR) is not a valid directory"; exit 1;
}

CSV=$(sk -e10 --no-multi --query="$SEMESTER $COURSE" \
		 < <(fd -e csv "$COURSE" --and "$SEMESTER" "$CSVDIR" --absolute-path) )
[[ -f "$CSV" && -r "$CSV" ]] || {
	echo "Error: Input CSV $CSV not found or unreadable"; exit 1;
}

case "$COURSE" in
    linux ) COURSE="Linux应用" ;;
    net   ) COURSE="计算机网络" ;;
	os    ) COURSE="操作系统原理" ;;
	*     ) echo 'COURSE should be one of os, net, linux!'; usage 1 ;;
esac

year1="20${SEMESTER:0:2}" # ${variable:start:offset}
year2="20${SEMESTER:2:2}"
term="${SEMESTER:5}"
SEMESTER="${year1}-${year2}-${term}"

org(){
	# copy $COURSE_DIR/20*.org to current directory
	paste \
		<(fd -e org -d 1 "$PATN" "$COURSE_DIR" | head -"$(qsv count $CSV)") \
		<(qsv select username,lastname,firstname "$CSV" | qsv behead | \
			  sed -e 's/,//g' -e 's/$/.org/') | sed 's/^/cp /' | bash

	# change TITLE, AUTHOR, DATE
	for f in 20*.org
	do
		IDNAME="${f%.*}"
		ID="${IDNAME:0:11}"
		NAME="${IDNAME:11}"

		sed -i \
			-e "/#+TITLE:/  s/:.*$/: 《${COURSE}》实验报告/" \
			-e "/#+AUTHOR:/ s/:.*$/: $NAME ($ID)/" \
			-e "/#+DATE:/   s/:.*$/: $SEMESTER/" \
			"$f"
	done
}

md() {
    # Validate essential inputs
    [[ -f "$CSV" ]] || { echo "Error: Input CSV $CSV not found"; exit 1; }
    [[ -d "$COURSE_DIR" ]] || { echo "Error: COURSE_DIR ($COURSE_DIR) not a directory"; exit 1; }
    [[ -f "$TEMPLATE_DIR/yaml" ]] || { echo "Error: YAML template $TEMPLATE_DIR/yaml not found"; exit 1; }

    # Step 1: Split CSV into 3 chunks
    OUTPUT_DIR="$(mktemp -d -t csv_chunks_XXXXXX)"
    qsv sort --random "$CSV" | qsv split "$OUTPUT_DIR" -c 3 --filename chunk_{}.csv

    # Collect chunk files using fd (sorted by row number)
    mapfile -t CHUNK < <(fd --type f --max-depth 1 'chunk_.*\.csv' "$OUTPUT_DIR" | sort -V)
    [[ ${#CHUNK[@]} -eq 3 ]] || {
        echo "Error: Expected 3 chunks, found ${#CHUNK[@]}"
        echo "${CHUNK[@]}"
        exit 1
    }
    [[ "$DEBUG" ]] && { echo 'CHUNK[]:' "${CHUNK[@]}"; }

    # Step 2: Extract username, lastname, firstname from each chunk
    prefixes=(a b c)
    for i in {0..2}; do
        prefix=${prefixes[$i]}
        chunk="${CHUNK[$i]}"
        mapfile -t "IDNAME_$prefix" < <(qsv apply dynfmt --formatstr '{username}{lastname}{firstname}' -c 'idname' "$chunk" | qsv select idname | qsv behead)
        eval "[[ \${#IDNAME_${prefix}[@]} -eq 0 ]] && echo \"Warning: No data for $prefix\""
    done

    [[ "$DEBUG" ]] && {
        for prefix in "${prefixes[@]}"; do
            eval "echo IDNAME_$prefix\[\]: \${IDNAME_${prefix}[*]}"
        done
    }

    # Step 3: Collect markdown files from COURSE_DIR
    for prefix in "${prefixes[@]}"; do
        mapfile -t "MD_$prefix" < <(fd --type f --max-depth 1 -e md "^$prefix" "$COURSE_DIR" --absolute-path)
        eval "[[ \${#MD_${prefix}[@]} -eq 0 ]] && echo \"Warning: No markdown files found for $prefix in $COURSE_DIR\""
    done

    [[ "$DEBUG" ]] && {
        for prefix in "${prefixes[@]}"; do
            eval "echo MD_$prefix\[\]: \${MD_${prefix}[*]}"
        done
    }

    # Step 4: Generate YAML files
    YAML="$TEMPLATE_DIR/yaml"
    [[ "$DEBUG" ]] && { echo "${YAML}:"; cat "$YAML"; }
    for prefix in "${prefixes[@]}"; do
        declare "YAML_$prefix=$(mktemp -p "$OUTPUT_DIR" --suffix .yaml)"
    done

    for prefix in "${prefixes[@]}"; do
        case $prefix in
            a) mark="A"; comment="Well done!" ;;
            b) mark="B"; comment="Good!" ;;
            c) mark="C"; comment="Not bad!" ;;
        esac
        eval "sed -e \"/mark:/ s/:.*\$/: $mark/\" \
                   -e \"/comment:/ s/:.*\$/: '$comment'/\" \
                   \"$YAML\" > \$YAML_$prefix"
    done

    [[ "$DEBUG" ]] && {
        for prefix in "${prefixes[@]}"; do
            eval "echo YAML_$prefix:; cat \$YAML_$prefix"
        done
    }

    # Step 5: Copy markdown and YAML files for each ID
    for prefix in "${prefixes[@]}"; do
		declare -n tmp_idname_array="IDNAME_$prefix"
		idname_array=( "${tmp_idname_array[@]}" )

		declare -n tmp_md_array="MD_$prefix"
		md_array=( "${tmp_md_array[@]}" )

		declare -n tmp_yaml_file="YAML_$prefix"
		yaml_file="$tmp_yaml_file"

        if [[ ${#md_array[@]} -eq 0 ]]; then
            echo "Error: No template file found for $prefix in $COURSE_DIR."
            usage 1
        elif [[ ${#md_array[@]} -eq 1 ]]; then
            [[ "$DEBUG" ]] && {
                echo "[$prefix] md:"
                for idname in "${idname_array[@]}"; do
                    echo "cp ${md_array[0]} $idname.md"
                done
                echo "[$prefix] yaml:"
                for idname in "${idname_array[@]}"; do
                    echo "cp $yaml_file $idname.yaml"
                done
            }
            for idname in "${idname_array[@]}"; do
                cp "${md_array[0]}" "${idname}.md"
                cp "$yaml_file" "${idname}.yaml"
            done
        else
            mapfile -t md_subset < <(fd --type f --max-depth 1 -e md "^$prefix" "$COURSE_DIR" --absolute-path | head -n "${#idname_array[@]}")
            [[ "${#md_subset[@]}" -ge "${#idname_array[@]}" ]] || {
                echo "Error: Not enough markdown files for $prefix (need ${#idname_array[@]}, found ${#md_subset[@]})"
                exit 1
            }
            [[ "$DEBUG" ]] && {
                echo "[$prefix] md:"
                for i in "${!idname_array[@]}"; do
                    echo "cp ${md_subset[$i]} ${idname_array[$i]}.md"
                done
            }
            for i in "${!idname_array[@]}"; do
                cp "${md_subset[$i]}" "${idname_array[$i]}.md"
            done
            [[ "$DEBUG" ]] && {
                echo "[$prefix] yaml:"
                for idname in "${idname_array[@]}"; do
                    echo "cp $yaml_file $idname.yaml"
                done
            }
            for idname in "${idname_array[@]}"; do
                cp "$yaml_file" "${idname}.yaml"
            done
        fi
    done

    # Step 6: Modify YAML files with class and comment date
    read -rp "Which CLASS? e.g. 计算机科学与技术2024班: " CLASS
    echo "CLASS: $CLASS"
    read -rp "Commentdate? e.g. 2024/11/1: " COMMENTDATE
    echo "COMMENTDATE: $COMMENTDATE"

    MKFILE="$TEMPLATE_DIR/Makefile"

    # Update YAML files
    for f in *.yaml; do
        [[ -f "$f" ]] || continue
        IDNAME="${f%.*}"
        ID="${IDNAME:0:11}"
        NAME="${IDNAME:11}"
        sed -i \
            -e "/title:/       s|:.*$|: '$COURSE'|" \
            -e "/author:/      s|:.*$|: '$NAME'|" \
            -e "/id:/          s|:.*$|: '$ID'|" \
            -e "/class:/       s|:.*$|: '$CLASS'|" \
            -e "/commentdate:/ s|:.*$|: '$COMMENTDATE'|" \
            -e "/term:/        s|:.*$|: '$SEMESTER'|" \
            "$f"
        mkdir -p "$IDNAME" && mv "$IDNAME".* "$IDNAME"
        sed "1 s/=.*$/= $IDNAME/" "$MKFILE" > Makefile
        cp Makefile "$IDNAME"
    done

    # Step 7: Generate PDFs
    YN='Y/n'
    printf "It will take a while to generate PDFs. Do you want to continue? [%s] " "$YN"
    read -r YN
    : "${YN:=Y}"
    case $YN in
        [nN]|[nN][oO]) ;;
        *) fd --type d -0 | xargs -I{} -0 -n1 -P 6 sh -c 'cd {} && make pdf && make clean' ;;
    esac
}

[[ "$FMT" = org ]] && org
[[ "$FMT" = md ]] && md
