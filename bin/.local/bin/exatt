#!/bin/bash

CSVDIR="/home/wx672/Documents/rsync/swfu/yearly/moodle-import"
OUTDIR='.'
unset SEMESTER COURSE DATE

usage() {
    cat <<EOF
Generating exam attendance file.

Usage: ${0##*/} [-h] <-t semester> <-r room> <-s subject> <-d date> [-c csvdir] [-o outdir] <course>

course - must be one of linux, net, os.
-t school term, e.g. 242501
-r 教室 (default 经管楼219)
-s 专业 (default 计算机科学与技术)
-d 考试时间, e.g. 2024年12月16日
-c csvdir, where the csv files kept (defaut $CSVDIR)
-o outdir (default ./)
-h help
EOF

exit "${1:-0}"
}

cleanup(){
	[[ -f "$TEX" ]] && {
		latexmk -c &>/dev/null
		rm chunk_*.csv "$TEX" "$TAIL" "$TMPCSV" || exit 1
	}
	
	TMPPDF="${TEX%.*}.pdf"
	[[ -f "$TMPPDF" ]] && {
		mv "$TMPPDF" "$PDF" || exit 1
		mupdf -C FDF6E3 "$PDF" &>/dev/null
	}
}

trap 'cleanup' EXIT

ROOM='经管楼219'
SUBJECT='计算机科学与技术'
DATE='\qquad{}年\qquad{}月\qquad{}日'

while getopts :ht:r:s:d:c:o: OPT; do
    case $OPT in
        h) usage 0 ;;
		t) SEMESTER="$OPTARG" ;;
		r) ROOM="$OPTARG" ;;
		s) SUBJECT="$OPTARG" ;;
		d) DATE="$OPTARG" ;;
		c) CSVDIR="$OPTARG" ;;
		o) OUTDIR="$OPTARG" ;;
		*) usage 1
    esac
done
shift $(( OPTIND - 1 ))
OPTIND=1

[[ ${#SEMESTER} = 6 ]] || {
	echo "SEMESTER=$SEMESTER. SEMESTER should be like e.g. 242501."
	usage 1
}
echo "SEMESTER=$SEMESTER"

CSV=$(sk -e10 --no-multi --query="$SEMESTER $COURSE" < <(fd -e csv "$*" "$CSVDIR") ) || {
	echo "CSV=$CSV"
	echo "Failed getting CSV file."
	exit 1
}

case "$1" in
    linux ) COURSE="Linux应用" ;;
    net ) COURSE="计算机网络" ;;
	os ) COURSE="操作系统原理" ;;
	* ) echo "COURSE=$COURSE. COURSE should be one of os, net, linux!"; usage 1 ;;
esac

PDF="$SEMESTER-$COURSE-考生签到表.pdf" # Don't move this line
echo "PDF=$PDF"

year1="20${SEMESTER:0:2}"
year2="20${SEMESTER:2:2}"
term="${SEMESTER:4:2}"
SEMESTER="${year1}--${year2}--${term}"

TMPCSV=$(mktemp --suffix ".csv")
TEX=$(mktemp --tmpdir="." --suffix=".tex")
TAIL=$(mktemp --suffix ".tex")

qsv enum --start 1 "$CSV" | \
	qsv apply dynfmt --formatstr '{lastname}{firstname}' -c 'Name' | \
	qsv select index,username,Name | \
	qsv rename '序号,学号,姓名' | \
	qsv apply dynfmt --formatstr '' -c '签名' > "$TMPCSV"

# qsv crashes if append this at the end of the above pipeline
qsv split "$OUTDIR" -c 2 --filename chunk_{}.csv "$TMPCSV"

csv2latex --longtable -l 0 < <(paste -d, chunk_*.csv) | \
	sed -e '1,/\\begin{longtable}{|l|l|l|l|l|l|l|l|}/d' > "$TAIL"

HEAD=$(cat <<EOF
\documentclass[scheme=chinese,zihao=-4]{ctexart}
\usepackage[hmargin=15mm,vmargin=2cm]{geometry}
\setCJKmainfont{Noto Serif CJK SC}
\usepackage{enumitem}
\usepackage{longtable}
\begin{document}
\begin{center}
{\LARGE 西南林业大学学生考试承诺}
\end{center}
\noindent{}对本场考试，我承诺如下：
\begin{enumerate}[nosep]
\item 服从监考教师对座位的重新安排。
\item 在规定的位置上正确、真实地书写自己的姓名、学号等有关信息。
\item 草稿书写在专用草稿纸上。
\item 不随意撕开考卷的装订。
\item 不将与考试无关的任何材料带入考场内。
\item 交卷时将考卷、答题纸、草搞纸等所有规定上交的材料一并交给监考教师，绝不将这些材料带出考场。
\item 保证遵守考试、考纪律，如违反考试、考场纪律，愿意根据有关规定接受学校的纪律处分。
\end{enumerate}
\begin{center}
教室：\underline{$ROOM}\qquad{}专业：\underline{$SUBJECT}\qquad{}考试时间：\underline{$DATE}
\end{center}
\vspace*{-7mm}
\begin{longtable}{|l|l|l|p{25mm}|l|l|l|p{25mm}|}
EOF
	)

cat <(echo "$HEAD") "$TAIL" > "$TEX"

cat "$TEX"

YN=yes
printf "Compile it?[%s]" "$YN"
read -r YN
: "${YN:=yes}"
case $YN in
	[nN]|[nN][oO]) true ;;
	*) latexmk "$TEX" ;;
esac
