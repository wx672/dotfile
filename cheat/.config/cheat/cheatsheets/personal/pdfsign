```sh
# split pages
pdftk os-marks.pdf burst

# sign a page

pdfsign -C -t'2024,12,18' pg_0001.pdf

pdfsign -c'4.2,1' -s'1.2,1' -t'2021,1,20' -S'王晓林' -p'12,1' pg_0001.pdf

# sign the analysis page

pdfsign -c'0,500' -w10cm -S'../analysis-improve.pdf' netprj-analysis.pdf

pdfsign -C -S'机试' -d'110' -t'2024,12,16' -c'100,0' netprj-analysis-signed.pdf


# join pages
pdftk pg*signed.pdf cat output os-marks-signed.pdf
```
